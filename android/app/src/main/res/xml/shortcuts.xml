<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="refresh_bills"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="Refresh"
        android:shortcutLongLabel="Refresh all bills">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="mydashboard://action/refresh"
            android:targetPackage="com.akbar.mydashboard"
            android:targetClass="com.akbar.mydashboard.MainActivity" />
    </shortcut>
    
    <shortcut
        android:shortcutId="add_service"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="Add Service"
        android:shortcutLongLabel="Add a new connection">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="mydashboard://action/add"
            android:targetPackage="com.akbar.mydashboard"
            android:targetClass="com.akbar.mydashboard.MainActivity" />
    </shortcut>
</shortcuts>
